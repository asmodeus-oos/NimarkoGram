uniform shader img;

uniform float2 resolution;
uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float4 foreground_color_premultiplied;

half sdfRect(half2 p, half4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x  = (p.y > 0.0) ? r.x  : r.y;
  half2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 srcOver(half4 src, half4 dst) {
    half3 outRGB = (src.rgb + dst.rgb * (1.0 - src.a));
    float outA = src.a + (1.0 - src.a) * dst.a;
    return half4(outRGB, outA);
}

half4 main(in float2 fragCoord) {
  half2 p = half2(fragCoord) - half2(center);
  half sd = sdfRect(p, radius);

  if (sd > 0.0) {
    return srcOver(half4(foreground_color_premultiplied), img.eval(fragCoord));
  }

  // Smooth edge factor from outer boundary to interior
  half t = max(thickness, 1.0);
  half edgeFactor = clamp(-sd / t, 0.0, 1.0);

  // Smooth curvature and normal calculation
  half sdX = sdfRect(p + half2(1.0, 0.0), radius);
  half sdY = sdfRect(p + half2(0.0, 1.0), radius);

  half blend = smoothstep(1.0, 0.0, edgeFactor);
  half n_z = sqrt(clamp(1.0 - (1.0 - edgeFactor) * (1.0 - edgeFactor), 0.01, 1.0));
  half3 normal = normalize(half3((sdX - sd) * blend, (sdY - sd) * blend, mix(1.0, n_z * 1.4, blend)));

  // Refraction with smooth falloff to avoid harsh cutoff
  half3 refract_vec = refract(half3(0.0, 0.0, -1.0), normal, 1.0 / max(refract_index, 1.0));
  half refract_length = t * 1.5 * blend;
  half2 offset = refract_vec.xy * refract_length * refract_intensity;

  // Prismatic chromatic dispersion along refraction bevel
  half r = img.eval(fragCoord + offset * 1.02).r;
  half4 gSample = img.eval(fragCoord + offset);
  half b = img.eval(fragCoord + offset * 0.98).b;
  half4 glassSample = half4(r, gSample.g, b, gSample.a);

  // Natural top lighting, smooth Fresnel sheen, and subtle ambient glass transmission
  half3 lightDir = half3(0.0, -0.7071, 0.7071);
  half spec = pow(max(dot(normal, lightDir), 0.0), 4.0) * 0.22 * blend;
  half fresnel = pow(clamp(1.0 - normal.z, 0.0, 1.0), 3.0) * 0.15 * blend;

  // Gentle top-to-bottom internal ambient illumination (eliminates dark hollow center)
  half normY = clamp((p.y + size.y) / max(size.y * 2.0, 1.0), 0.0, 1.0);
  half ambientGlassSheen = (1.0 - normY) * 0.045 + 0.015;

  glassSample.rgb += half3(spec + fresnel + ambientGlassSheen);

  return srcOver(half4(foreground_color_premultiplied), glassSample);
}